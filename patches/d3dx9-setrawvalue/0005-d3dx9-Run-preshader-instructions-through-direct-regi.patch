+}
+
+/* The fast path reads and writes the same registers in the same order as
+ * exec_get_arg() / exec_set_arg() and computes every result with the same
+ * double precision operations, so the results are bit identical. */
+static inline double fast_input(const struct d3dx_pres_ins *ins, unsigned int k, unsigned int comp)
+{
+    if (ins->input_double[k])
+        return ((const double *)ins->input_ptr[k])[comp];
+    return ((const float *)ins->input_ptr[k])[comp];
+}
+
+static inline void fast_output(const struct d3dx_pres_ins *ins, unsigned int comp, double v)
+{
+    switch (ins->output_type)
+    {
+        case PRES_VT_FLOAT: ((float *)ins->output_ptr)[comp] = v; break;
+        case PRES_VT_DOUBLE: ((double *)ins->output_ptr)[comp] = v; break;
+        case PRES_VT_INT: ((int *)ins->output_ptr)[comp] = lrint(v); break;
+        case PRES_VT_BOOL: ((BOOL *)ins->output_ptr)[comp] = !!v; break;
+        default: break;
+    }
+}
+
+static void execute_ins_fast(const struct d3dx_pres_ins *ins)
+{
+    const struct op_info *oi = &pres_op_info[ins->op];
+    unsigned int j, k, n = ins->component_count, s = ins->scalar_op ? 0 : 1;
+    double args[ARGS_ARRAY_SIZE];
+
+    if (oi->func_all_comps)
+    {
+        for (k = 0; k < oi->input_count; ++k)
+            for (j = 0; j < n; ++j)
+                args[k * n + j] = fast_input(ins, k, !k ? j * s : j);
+        fast_output(ins, 0, oi->func(args, n));
+        return;
+    }
+    switch (ins->op)
+    {
+        case PRESHADER_OP_MOV:
+            for (j = 0; j < n; ++j)
+                fast_output(ins, j, fast_input(ins, 0, j * s));
+            break;
+        case PRESHADER_OP_NEG:
+            for (j = 0; j < n; ++j)
+                fast_output(ins, j, -fast_input(ins, 0, j * s));
+            break;
+        case PRESHADER_OP_RCP:
+            for (j = 0; j < n; ++j)
+                fast_output(ins, j, 1.0 / fast_input(ins, 0, j * s));
+            break;
+        case PRESHADER_OP_ADD:
+            for (j = 0; j < n; ++j)
+                fast_output(ins, j, fast_input(ins, 0, j * s) + fast_input(ins, 1, j));
+            break;
+        case PRESHADER_OP_MUL:
+            for (j = 0; j < n; ++j)
+                fast_output(ins, j, fast_input(ins, 0, j * s) * fast_input(ins, 1, j));
+            break;
+        case PRESHADER_OP_LT:
+            for (j = 0; j < n; ++j)
+                fast_output(ins, j, fast_input(ins, 0, j * s) < fast_input(ins, 1, j) ? 1.0 : 0.0);
+            break;
+        case PRESHADER_OP_GE:
+            for (j = 0; j < n; ++j)
+                fast_output(ins, j, fast_input(ins, 0, j * s) >= fast_input(ins, 1, j) ? 1.0 : 0.0);
+            break;
+        case PRESHADER_OP_CMP:
+            for (j = 0; j < n; ++j)
+                fast_output(ins, j, fast_input(ins, 0, j * s) >= 0.0
+                        ? fast_input(ins, 1, j) : fast_input(ins, 2, j));
+            break;
+        default:
+            for (j = 0; j < n; ++j)
             {
                 for (k = 0; k < oi->input_count; ++k)
-                    args[k] = exec_get_arg(&pres->regs, &ins->inputs[k], ins->scalar_op && !k ? 0 : j);
-                res = oi->func(args, ins->component_count);
-                exec_set_arg(&pres->regs, &ins->output.reg, j, res);
+                    args[k] = fast_input(ins, k, !k ? j * s : j);
+                fast_output(ins, j, oi->func(args, n));
             }
-        }
+            break;
+    }
+}
+
+static HRESULT execute_ins(struct d3dx_preshader *pres, const struct d3dx_pres_ins *ins)
+{
+    if (ins->fast)
+    {
+        execute_ins_fast(ins);
+        return D3D_OK;
     }
+    return execute_ins_generic(&pres->regs, ins);
+}
+
+static HRESULT execute_all_ins(struct d3dx_preshader *pres)
+{
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < pres->ins_count; ++i)
+        if (FAILED(hr = execute_ins(pres, &pres->ins[i])))
+            return hr;
     return D3D_OK;
 }
 
+static void init_fast_instructions(struct d3dx_preshader *pres)
+{
+    struct d3dx_regstore *rs = &pres->regs;
+    unsigned int i, k, table, last;
+
+    if (!(d3dx_fxopt() & D3DX_FXOPT_FAST_PRESHADER))
+        return;
+    for (i = 0; i < pres->ins_count; ++i)
+    {
+        struct d3dx_pres_ins *ins = &pres->ins[i];
+        const struct op_info *oi = &pres_op_info[ins->op];
+
+        if (oi->func_all_comps && oi->input_count * ins->component_count > ARGS_ARRAY_SIZE)
+            continue;
+        for (k = 0; k < oi->input_count; ++k)
+        {
+            const struct d3dx_pres_operand *opr = &ins->inputs[k];
+
+            table = opr->reg.table;
+            last = opr->reg.offset + (ins->scalar_op && !k ? 0 : ins->component_count - 1);
+            if (opr->index_reg.table != PRES_REGTAB_COUNT || !rs->tables[table]
+                    || get_reg_offset(table, last) >= rs->table_sizes[table]
+                    || (table_info[table].type != PRES_VT_FLOAT && table_info[table].type != PRES_VT_DOUBLE))
+                break;
+            ins->input_ptr[k] = (BYTE *)rs->tables[table] + table_info[table].component_size * opr->reg.offset;
+            ins->input_double[k] = table_info[table].type == PRES_VT_DOUBLE;
+        }
+        if (k < oi->input_count)
+            continue;
+        table = ins->output.reg.table;
+        last = ins->output.reg.offset + (oi->func_all_comps ? 0 : ins->component_count - 1);
+        if (!rs->tables[table] || get_reg_offset(table, last) >= rs->table_sizes[table])
+            continue;
+        ins->output_ptr = (BYTE *)rs->tables[table] + table_info[table].component_size * ins->output.reg.offset;
+        ins->output_type = table_info[table].type;
+        ins->fast = TRUE;
+    }
+}
+
+static HRESULT execute_preshader(struct d3dx_preshader *pres)
+{
+    return execute_all_ins(pres);
+}
+
 static BOOL is_const_tab_input_dirty(struct d3dx_const_tab *ctab, ULONG64 update_version)
 {
     unsigned int i;
