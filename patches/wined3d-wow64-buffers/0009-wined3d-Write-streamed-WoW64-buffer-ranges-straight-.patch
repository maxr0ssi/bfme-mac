+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_WINED3D_UNIXLIB_H
+#define __WINE_WINED3D_UNIXLIB_H
+
+#include "wine/unixlib.h"
+
+/* Fixed-width fields only, so 32-bit (WoW64) and 64-bit callers share one layout. */
+struct wined3d_unix_buffer_write_params
+{
+    UINT64 data;        /* source address in the caller's address space */
+    UINT32 target;      /* GL binding point the destination buffer is bound to */
+    UINT32 offset;
+    UINT32 size;
+    UINT32 orphan_size; /* non-zero: glBufferData(NULL) the whole buffer first (a D3D DISCARD) */
+    UINT32 orphan_usage;
+    UINT32 pad;
+};
+
+enum wined3d_unix_funcs
+{
+    unix_buffer_write,
+    unix_funcs_count,
+};
+
+#endif /* __WINE_WINED3D_UNIXLIB_H */
