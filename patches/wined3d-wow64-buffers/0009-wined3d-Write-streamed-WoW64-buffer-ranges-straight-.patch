 dlls/wined3d/wined3d_private.h |  5 ++
 8 files changed, 194 insertions(+), 6 deletions(-)
 create mode 100644 dlls/wined3d/unix_gl.c
 create mode 100644 dlls/wined3d/unixlib.h

