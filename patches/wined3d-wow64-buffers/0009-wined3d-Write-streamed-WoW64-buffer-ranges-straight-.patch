diff --git a/dlls/wined3d/buffer.c b/dlls/wined3d/buffer.c
index 8ef3a2d2ca4..d777b9535bb 100644
--- a/dlls/wined3d/buffer.c
+++ b/dlls/wined3d/buffer.c
@@ -789,7 +789,15 @@ void wined3d_buffer_acquire_bo_for_write(struct wined3d_buffer *buffer, struct w
 void wined3d_buffer_copy_bo_address(struct wined3d_buffer *dst_buffer, struct wined3d_context *context,
         unsigned int dst_offset, const struct wined3d_const_bo_address *src_addr, unsigned int size)
 {
-    uint32_t map_flags = WINED3D_MAP_WRITE;
+    wined3d_buffer_copy_bo_address_flags(dst_buffer, context, dst_offset, src_addr, size, 0);
+}
+
+/* extra_map_flags: WINED3D_MAP_NOOVERWRITE or WINED3D_MAP_DISCARD when the data was written under
+ * such a D3D map, which lets the copy skip synchronising with the GPU. */
+void wined3d_buffer_copy_bo_address_flags(struct wined3d_buffer *dst_buffer, struct wined3d_context *context,
+        unsigned int dst_offset, const struct wined3d_const_bo_address *src_addr, unsigned int size, uint32_t extra_map_flags)
+{
+    uint32_t map_flags = WINED3D_MAP_WRITE | extra_map_flags;
     struct wined3d_bo_address dst_addr;
     struct wined3d_range range;
     DWORD dst_location;
@@ -877,7 +885,9 @@ void wined3d_buffer_update_sub_resource(struct wined3d_buffer *buffer, struct wi
     }
     else
     {
-        wined3d_buffer_copy_bo_address(buffer, context, offset, &upload_bo->addr, size);
+        wined3d_buffer_copy_bo_address_flags(buffer, context, offset, &upload_bo->addr, size,
+                (flags & UPLOAD_BO_DISCARD ? WINED3D_MAP_DISCARD : 0)
+                | (flags & UPLOAD_BO_NOOVERWRITE ? WINED3D_MAP_NOOVERWRITE : 0));
     }
 }
 
diff --git a/dlls/wined3d/context_gl.c b/dlls/wined3d/context_gl.c
index 64ea956c7db..62a59e3d701 100644
--- a/dlls/wined3d/context_gl.c
+++ b/dlls/wined3d/context_gl.c
@@ -26,6 +26,7 @@
 
 #include "wined3d_private.h"
 #include "wined3d_gl.h"
+#include "unixlib.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(d3d);
 WINE_DECLARE_DEBUG_CHANNEL(d3d_perf);
@@ -3056,7 +3057,32 @@ void wined3d_context_gl_copy_bo_address(struct wined3d_context_gl *context_gl,
     }
     else if (dst_bo && !src_bo)
     {
-        if ((map_flags & WINED3D_MAP_DISCARD) && (dst_bo->flags & GL_MAP_WRITE_BIT)
+        if ((map_flags & (WINED3D_MAP_DISCARD | WINED3D_MAP_NOOVERWRITE)) && wined3d_unixlib_loaded
+                && !dst_bo->memory && !dst_bo->b.map_ptr
+                && wined3d_wow64_buffer_mode(context_gl->c.device) == WINED3D_WOW64_BUFFERS_STREAM)
+        {
+            struct wined3d_unix_buffer_write_params params;
+
+            wined3d_context_gl_bind_bo(context_gl, dst_bo->binding, dst_bo->id);
+            for (i = 0; i < range_count; ++i)
+            {
+                params.data = (ULONG_PTR)(src->addr + ranges[i].offset);
+                params.target = dst_bo->binding;
+                params.offset = dst_bo->b.buffer_offset + (ULONG_PTR)dst->addr + ranges[i].offset;
+                params.size = ranges[i].size;
+                params.orphan_size = (!i && (map_flags & WINED3D_MAP_DISCARD)) ? dst_bo->size : 0;
+                params.orphan_usage = dst_bo->usage;
+                params.pad = 0;
+                if (WINE_UNIX_CALL(unix_buffer_write, &params))
+                {
+                    ERR("Direct buffer write failed, falling back to glBufferSubData().\n");
+                    wined3d_unixlib_loaded = FALSE;
+                    GL_EXTCALL(glBufferSubData(dst_bo->binding, params.offset, params.size, src->addr + ranges[i].offset));
+                }
+            }
+            wined3d_context_gl_reference_bo(context_gl, dst_bo);
+        }
+        else if ((map_flags & WINED3D_MAP_DISCARD) && (dst_bo->flags & GL_MAP_WRITE_BIT)
                 && wined3d_wow64_buffer_mode(context_gl->c.device) == WINED3D_WOW64_BUFFERS_OFF)
         {
             dst_ptr = wined3d_context_gl_map_bo_address(context_gl, dst, dst_bo->size, map_flags);
