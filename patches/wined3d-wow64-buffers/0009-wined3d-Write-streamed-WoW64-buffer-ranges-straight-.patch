diff --git a/dlls/wined3d/unix_gl.c b/dlls/wined3d/unix_gl.c
new file mode 100644
index 00000000000..3312cecccc8
--- /dev/null
+++ b/dlls/wined3d/unix_gl.c
@@ -0,0 +1,98 @@
+/*
+ * wined3d's Unix-side helpers: direct writes into host GL buffer memory
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dlfcn.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "unixlib.h"
+
+/* A WoW64 process cannot address the host driver's buffer mappings (they live above 4 GiB), so
+ * opengl32 hands every glMapBufferRange() a temporary 32-bit copy instead: an allocation, extra
+ * calls and two copies, ~90 us per map/unmap on macOS. wined3d's CS thread calls this instead: one
+ * transition, then an unsynchronized map of just the written range, a memcpy from the 32-bit
+ * source, and an unmap - ~0.2 us natively. The caller must guarantee that no pending draw reads
+ * the range (D3D NOOVERWRITE), or ask for the buffer to be orphaned first (D3D DISCARD).
+ * The host GL context is current on this thread: wined3d made it current through opengl32. */
+
+typedef unsigned int GLenum;
+typedef unsigned int GLbitfield;
+typedef unsigned char GLboolean;
+typedef long GLintptr;
+typedef long GLsizeiptr;
+
+#define GL_MAP_WRITE_BIT                0x0002
+#define GL_MAP_INVALIDATE_RANGE_BIT     0x0004
+#define GL_MAP_UNSYNCHRONIZED_BIT       0x0020
+
+static void *(*p_glMapBufferRange)(GLenum, GLintptr, GLsizeiptr, GLbitfield);
+static GLboolean (*p_glUnmapBuffer)(GLenum);
+static void (*p_glBufferData)(GLenum, GLsizeiptr, const void *, GLenum);
+
+static NTSTATUS process_attach(void *args)
+{
+    p_glMapBufferRange = dlsym(RTLD_DEFAULT, "glMapBufferRange");
+    p_glUnmapBuffer = dlsym(RTLD_DEFAULT, "glUnmapBuffer");
+    p_glBufferData = dlsym(RTLD_DEFAULT, "glBufferData");
+    return p_glMapBufferRange && p_glUnmapBuffer && p_glBufferData ? STATUS_SUCCESS : STATUS_NOT_SUPPORTED;
+}
+
+static NTSTATUS buffer_write(void *args)
+{
+    const struct wined3d_unix_buffer_write_params *params = args;
+    void *ptr;
+
+    if (!p_glMapBufferRange && process_attach(NULL))
+        return STATUS_NOT_SUPPORTED;
+    if (params->orphan_size)
+        p_glBufferData(params->target, params->orphan_size, NULL, params->orphan_usage);
+    if (!(ptr = p_glMapBufferRange(params->target, params->offset, params->size,
+            GL_MAP_WRITE_BIT | GL_MAP_INVALIDATE_RANGE_BIT | GL_MAP_UNSYNCHRONIZED_BIT)))
+        return STATUS_UNSUCCESSFUL;
+    memcpy(ptr, (const void *)(ULONG_PTR)params->data, params->size);
+    p_glUnmapBuffer(params->target);
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    buffer_write,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count);
+
+#ifdef _WIN64
+
+/* The parameter layout is the same for 32-bit callers. */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    buffer_write,
+};
+
+C_ASSERT(ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count);
+
+#endif /* _WIN64 */
