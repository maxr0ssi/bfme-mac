+/* Reads the records of earlier runs; a missing file, a file from another version of the record
+ * layout and a partial record at the end are all dealt with by starting over or truncating. */
+static void glsl_program_cache_load(struct glsl_program_cache *cache)
+{
+    struct glsl_program_cache_header header, expected;
+    struct glsl_program_record record;
+    struct glsl_known_program *known;
+    unsigned int count = 0;
+    DWORD size;
+    LARGE_INTEGER end;
+
+    glsl_program_cache_header_init(&expected);
+    if (!ReadFile(cache->file, &header, sizeof(header), &size, NULL) || size != sizeof(header)
+            || memcmp(&header, &expected, sizeof(header)))
+    {
+        TRACE("Starting a new program cache.\n");
+        SetFilePointer(cache->file, 0, NULL, FILE_BEGIN);
+        SetEndOfFile(cache->file);
+        WriteFile(cache->file, &expected, sizeof(expected), &size, NULL);
+        return;
     }
