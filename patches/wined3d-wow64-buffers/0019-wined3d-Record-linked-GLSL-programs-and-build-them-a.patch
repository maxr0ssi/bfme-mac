+static void set_glsl_shader_program(const struct wined3d_context_gl *context_gl, const struct wined3d_state *state,
+        struct shader_glsl_priv *priv, struct glsl_context_data *ctx_data)
+{
+    const struct wined3d_d3d_info *d3d_info = context_gl->c.d3d_info;
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    struct wined3d_shader *hshader, *dshader, *gshader;
+    struct glsl_shader_prog_link *entry = NULL;
+    struct glsl_program_desc desc = {0};
+    struct wined3d_shader *vshader = NULL;
+    struct wined3d_shader *pshader = NULL;
+    struct glsl_program_key key;
+    GLuint vs_id = 0;
+    GLuint hs_id = 0;
+    GLuint ds_id = 0;
+    GLuint gs_id = 0;
+    GLuint ps_id = 0;
+    struct list *ps_list = NULL, *vs_list = NULL;
+
+    if (!(context_gl->c.shader_update_mask & (1u << WINED3D_SHADER_TYPE_VERTEX)) && ctx_data->glsl_program)
+    {
+        vs_id = ctx_data->glsl_program->vs.id;
+        vs_list = &ctx_data->glsl_program->vs.shader_entry;
+        desc.ffp_vs = ctx_data->glsl_program->ffp_vs;
+
+        if (use_vs(state) || d3d_info->ffp_hlsl)
+            vshader = state->shader[WINED3D_SHADER_TYPE_VERTEX];
+    }
+    else if (use_vs(state) || d3d_info->ffp_hlsl)
+    {
+        struct vs_compile_args vs_compile_args;
+
+        vshader = state->shader[WINED3D_SHADER_TYPE_VERTEX];
+
+        find_vs_compile_args(state, vshader, &vs_compile_args, &context_gl->c);
+        vs_id = find_glsl_vertex_shader(context_gl, priv, vshader, &vs_compile_args);
+        vs_list = &vshader->linked_programs;
+    }
+    else if (priv->vertex_pipe == &glsl_vertex_pipe)
+    {
+        struct glsl_ffp_vertex_shader *ffp_shader;
+        struct wined3d_ffp_vs_settings settings;
+
+        wined3d_ffp_get_vs_settings(state, &context_gl->c.stream_info, d3d_info, &settings);
+        ffp_shader = shader_glsl_find_ffp_vertex_shader(priv, gl_info, &settings);
+        vs_id = ffp_shader->id;
+        vs_list = &ffp_shader->linked_programs;
+        desc.ffp_vs = ffp_shader;
+    }
+
+    hshader = state->shader[WINED3D_SHADER_TYPE_HULL];
+    if (!(context_gl->c.shader_update_mask & (1u << WINED3D_SHADER_TYPE_HULL)) && ctx_data->glsl_program)
+        hs_id = ctx_data->glsl_program->hs.id;
+    else if (hshader)
+        hs_id = find_glsl_hull_shader(context_gl, priv, hshader);
+
+    dshader = state->shader[WINED3D_SHADER_TYPE_DOMAIN];
+    if (!(context_gl->c.shader_update_mask & (1u << WINED3D_SHADER_TYPE_DOMAIN)) && ctx_data->glsl_program)
+    {
+        ds_id = ctx_data->glsl_program->ds.id;
+    }
+    else if (dshader)
+    {
+        struct ds_compile_args args;
+
+        find_ds_compile_args(state, dshader, &args, &context_gl->c);
+        ds_id = find_glsl_domain_shader(context_gl, priv, dshader, &args);
+    }
+
+    gshader = state->shader[WINED3D_SHADER_TYPE_GEOMETRY];
+    if (!(context_gl->c.shader_update_mask & (1u << WINED3D_SHADER_TYPE_GEOMETRY)) && ctx_data->glsl_program)
+    {
+        gs_id = ctx_data->glsl_program->gs.id;
+    }
+    else if (gshader)
+    {
+        struct gs_compile_args args;
+
+        find_gs_compile_args(state, gshader, &args, &context_gl->c);
+        gs_id = find_glsl_geometry_shader(context_gl, priv, gshader, &args);
+    }
+
+    /* A pixel shader is not used when rasterization is disabled. */
+    if (is_rasterization_disabled(gshader))
+    {
+        ps_id = 0;
+        ps_list = NULL;
+    }
+    else if (!(context_gl->c.shader_update_mask & (1u << WINED3D_SHADER_TYPE_PIXEL)) && ctx_data->glsl_program)
+    {
+        ps_id = ctx_data->glsl_program->ps.id;
+        ps_list = &ctx_data->glsl_program->ps.shader_entry;
+        desc.ffp_ps = ctx_data->glsl_program->ffp_ps;
+
+        if (use_ps(state))
+            pshader = state->shader[WINED3D_SHADER_TYPE_PIXEL];
+    }
+    else if (use_ps(state))
+    {
+        struct ps_compile_args ps_compile_args;
+        pshader = state->shader[WINED3D_SHADER_TYPE_PIXEL];
+        find_ps_compile_args(state, pshader, context_gl->c.stream_info.position_transformed,
+                &ps_compile_args, &context_gl->c);
+        ps_id = find_glsl_fragment_shader(context_gl, priv, pshader, &ps_compile_args);
+        ps_list = &pshader->linked_programs;
+    }
+    else if (priv->fragment_pipe == &glsl_fragment_pipe
+            && !(vshader && vshader->reg_maps.shader_version.major >= 4))
+    {
+        struct glsl_ffp_fragment_shader *ffp_shader;
+        struct ffp_frag_settings settings;
+
+        wined3d_ffp_get_fs_settings(state, d3d_info, &settings);
+        ffp_shader = shader_glsl_find_ffp_fragment_shader(priv, &settings, context_gl);
+        ps_id = ffp_shader->id;
+        ps_list = &ffp_shader->linked_programs;
+        desc.ffp_ps = ffp_shader;
+    }
+
+    key.vs_id = vs_id;
+    key.hs_id = hs_id;
+    key.ds_id = ds_id;
+    key.gs_id = gs_id;
+    key.ps_id = ps_id;
+    key.cs_id = 0;
+    if ((!vs_id && !hs_id && !ds_id && !gs_id && !ps_id) || (entry = get_glsl_program_entry(priv, &key)))
+    {
+        ctx_data->glsl_program = entry;
+        return;
+    }
+
+    desc.vs_id = vs_id;
+    desc.hs_id = hs_id;
+    desc.ds_id = ds_id;
+    desc.gs_id = gs_id;
+    desc.ps_id = ps_id;
+    desc.vs_list = vs_list;
+    desc.ps_list = ps_list;
+    desc.vshader = vshader;
+    desc.hshader = hshader;
+    desc.dshader = dshader;
+    desc.gshader = gshader;
+    desc.pshader = pshader;
+    desc.per_vertex_point_size = vshader && state->primitive_type == WINED3D_PT_POINTLIST
+            && vshader->reg_maps.point_size;
+    desc.flatshading = d3d_info->emulated_flatshading
+            && state->render_states[WINED3D_RS_SHADEMODE] == WINED3D_SHADE_FLAT;
+    desc.dual_source = state->blend_state && state->blend_state->dual_source;
+    ctx_data->glsl_program = shader_glsl_create_graphics_program(context_gl, priv, &desc);
+    shader_glsl_program_cache_record(priv, context_gl, &desc);
+}
+
+/* Context activation is done by the caller. */
+static BOOL glsl_program_cache_is_live(struct glsl_program_cache *cache, uint64_t hash, struct wined3d_shader *shader)
+{
+    struct glsl_live_shader *live;
+    struct wine_rb_entry *entry;
+    unsigned int i;
+
+    if (!(entry = wine_rb_get(&cache->live, &hash)))
+        return FALSE;
+    live = WINE_RB_ENTRY_VALUE(entry, struct glsl_live_shader, entry);
+    for (i = 0; i < live->count; ++i)
+    {
+        if (live->shaders[i].shader == shader)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/* Context activation is done by the caller. */
+static void shader_glsl_build_recorded_program(struct shader_glsl_priv *priv,
+        struct wined3d_context_gl *context_gl, const struct glsl_program_job *job)
+{
+    const struct glsl_program_record *record = &job->known->record;
+    struct glsl_context_data *ctx_data = context_gl->c.shader_backend_data;
+    struct glsl_program_cache *cache = priv->program_cache;
+    const struct wined3d_gl_info *gl_info = context_gl->gl_info;
+    struct glsl_program_desc desc = {0};
+    struct glsl_program_key key = {0};
+
+    if (record->flags & GLSL_PROGRAM_VS_FFP)
+    {
+        struct glsl_ffp_vertex_shader *ffp_vs;
+
+        if (priv->vertex_pipe != &glsl_vertex_pipe
+                || !(ffp_vs = shader_glsl_find_ffp_vertex_shader(priv, gl_info, &record->vs.ffp)))
+            return;
+        desc.vs_id = ffp_vs->id;
+        desc.vs_list = &ffp_vs->linked_programs;
+        desc.ffp_vs = ffp_vs;
+    }
+    else
+    {
+        if (!glsl_program_cache_is_live(cache, record->vs_hash, job->vshader))
+            return;
+        desc.vshader = job->vshader;
+        desc.vs_id = find_glsl_vertex_shader_use_map(context_gl, priv, desc.vshader, &record->vs.shader, record->use_map);
+        desc.vs_list = &desc.vshader->linked_programs;
+    }
+
+    if (record->flags & GLSL_PROGRAM_PS_FFP)
+    {
+        struct glsl_ffp_fragment_shader *ffp_ps;
+
+        if (priv->fragment_pipe != &glsl_fragment_pipe
+                || !(ffp_ps = shader_glsl_find_ffp_fragment_shader(priv, &record->ps.ffp, context_gl)))
+            return;
+        desc.ps_id = ffp_ps->id;
+        desc.ps_list = &ffp_ps->linked_programs;
+        desc.ffp_ps = ffp_ps;
+    }
+    else if (!(record->flags & GLSL_PROGRAM_PS_NONE))
+    {
+        if (!glsl_program_cache_is_live(cache, record->ps_hash, job->pshader))
+            return;
+        desc.pshader = job->pshader;
+        desc.ps_id = find_glsl_fragment_shader(context_gl, priv, desc.pshader, &record->ps.shader);
+        desc.ps_list = &desc.pshader->linked_programs;
+    }
+
+    if (!desc.vs_id || (!desc.ps_id && !(record->flags & GLSL_PROGRAM_PS_NONE)))
+        return;
+    key.vs_id = desc.vs_id;
+    key.ps_id = desc.ps_id;
+    if (get_glsl_program_entry(priv, &key))
+        return;
+
+    desc.per_vertex_point_size = !!(record->flags & GLSL_PROGRAM_POINT_SIZE);
+    desc.flatshading = !!(record->flags & GLSL_PROGRAM_FLATSHADING);
+    desc.dual_source = !!(record->flags & GLSL_PROGRAM_DUAL_SOURCE);
+    shader_glsl_create_graphics_program(context_gl, priv, &desc);
+    ++cache->built;
+    TRACE("Built recorded program %u of %u.\n", cache->built, cache->known_count);
+
+    /* Linking made the new program current; draws expect the one they last used. */
+    GL_EXTCALL(glUseProgram(ctx_data->glsl_program ? ctx_data->glsl_program->id : 0));
+    checkGLcall("glUseProgram");
+}
+
+/* Called by the CS thread when both its queues are empty: builds one recorded program. Returns
+ * whether it did, so that the CS looks at its queues again before building the next. */
+static bool shader_glsl_idle_work(struct wined3d_device *device)
+{
+    struct shader_glsl_priv *priv = device->shader_priv;
+    struct glsl_program_cache *cache;
+    struct wined3d_context *context;
+    struct glsl_program_job job;
+
+    if (!priv || !(cache = priv->program_cache) || cache->pending_next == cache->pending_count)
+        return false;
+    if (!device->d3d_initialized || !device->context_count)
+        return false;
+
+    job = cache->pending[cache->pending_next++];
+    if (cache->pending_next == cache->pending_count)
+        cache->pending_next = cache->pending_count = 0;
+
+    context = context_acquire(device, NULL, 0);
+    shader_glsl_build_recorded_program(priv, wined3d_context_gl(context), &job);
+    context_release(context);
+    return true;
+}
+
+/* The newest live D3D shader with this byte code. */
+static const struct glsl_live_shader_object *glsl_program_cache_newest(struct glsl_program_cache *cache, uint64_t hash)
+{
+    struct glsl_live_shader *live;
+    struct wine_rb_entry *entry;
+
+    if (!(entry = wine_rb_get(&cache->live, &hash)))
+        return NULL;
+    live = WINE_RB_ENTRY_VALUE(entry, struct glsl_live_shader, entry);
+    return live->count ? &live->shaders[live->count - 1] : NULL;
+}
+
+/* A new vertex or pixel shader: queue the recorded programs it completes, each with the newest
+ * live shader for its other half. Applications create shaders that are used together one after
+ * the other, also when they create the same byte code more than once (effects); when this byte
+ * code exists already, a partner older than its previous copy belongs to that copy, which had its
+ * programs queued when it was created. */
+static void shader_glsl_program_cache_shader_created(struct shader_glsl_priv *priv, struct wined3d_shader *shader)
+{
+    enum wined3d_shader_type type = shader->reg_maps.shader_version.type;
+    const struct glsl_live_shader_object *partner;
+    struct wined3d_shader *vshader, *pshader;
+    struct glsl_program_cache *cache;
+    struct glsl_known_program *known;
+    struct glsl_live_shader *live;
+    struct wine_rb_entry *entry;
+    unsigned int previous = 0;
+    uint64_t hash;
+
+    if ((type != WINED3D_SHADER_TYPE_VERTEX && type != WINED3D_SHADER_TYPE_PIXEL)
+            || shader->reg_maps.shader_version.major >= 4)
+        return;
+    if (!(cache = glsl_program_cache_get(priv)) || !(hash = glsl_shader_get_hash(shader)))
+        return;
+
+    if ((entry = wine_rb_get(&cache->live, &hash)))
+    {
+        live = WINE_RB_ENTRY_VALUE(entry, struct glsl_live_shader, entry);
+    }
+    else
+    {
+        if (!(live = calloc(1, sizeof(*live))))
+            return;
+        live->hash = hash;
+        wine_rb_put(&cache->live, &live->hash, &live->entry);
+    }
+    if (!wined3d_array_reserve((void **)&live->shaders, &live->size, live->count + 1, sizeof(*live->shaders)))
+        return;
+    if (live->count)
+        previous = live->shaders[live->count - 1].serial;
+    live->shaders[live->count].shader = shader;
+    live->shaders[live->count++].serial = ++cache->serial;
+
+    WINE_RB_FOR_EACH_ENTRY(known, &cache->known, struct glsl_known_program, entry)
+    {
+        const struct glsl_program_record *record = &known->record;
+
+        if (type == WINED3D_SHADER_TYPE_VERTEX)
+        {
+            if ((record->flags & GLSL_PROGRAM_VS_FFP) || record->vs_hash != hash)
+                continue;
+            vshader = shader;
+            pshader = NULL;
+            if (!(record->flags & (GLSL_PROGRAM_PS_FFP | GLSL_PROGRAM_PS_NONE)))
+            {
+                if (!(partner = glsl_program_cache_newest(cache, record->ps_hash)) || partner->serial < previous)
+                    continue;
+                pshader = partner->shader;
+            }
+        }
+        else
+        {
+            if ((record->flags & (GLSL_PROGRAM_PS_FFP | GLSL_PROGRAM_PS_NONE)) || record->ps_hash != hash)
+                continue;
+            pshader = shader;
+            vshader = NULL;
+            if (!(record->flags & GLSL_PROGRAM_VS_FFP))
+            {
+                if (!(partner = glsl_program_cache_newest(cache, record->vs_hash)) || partner->serial < previous)
+                    continue;
+                vshader = partner->shader;
+            }
+        }
+        glsl_program_cache_queue(cache, known, vshader, pshader);
+    }
+}
+
+static void shader_glsl_program_cache_shader_destroyed(struct shader_glsl_priv *priv, struct wined3d_shader *shader)
+{
+    struct glsl_shader_private *shader_data = shader->backend_data;
+    struct glsl_program_cache *cache;
+    struct glsl_live_shader *live;
+    struct wine_rb_entry *entry;
+    unsigned int i;
+
+    if (!priv || !(cache = priv->program_cache) || !shader_data || !shader_data->hash)
+        return;
+    if (!(entry = wine_rb_get(&cache->live, &shader_data->hash)))
+        return;
+    live = WINE_RB_ENTRY_VALUE(entry, struct glsl_live_shader, entry);
+    for (i = 0; i < live->count; ++i)
+    {
+        if (live->shaders[i].shader != shader)
+            continue;
+        memmove(&live->shaders[i], &live->shaders[i + 1], (live->count - i - 1) * sizeof(*live->shaders));
+        --live->count;
+        break;
+    }
+    if (live->count)
+        return;
+    wine_rb_remove(&cache->live, &live->entry);
+    free(live->shaders);
+    free(live);
+}
+
+static void glsl_program_cache_free_known(struct wine_rb_entry *entry, void *param)
+{
+    free(WINE_RB_ENTRY_VALUE(entry, struct glsl_known_program, entry));
+}
+
+static void glsl_program_cache_free_live(struct wine_rb_entry *entry, void *param)
+{
+    struct glsl_live_shader *live = WINE_RB_ENTRY_VALUE(entry, struct glsl_live_shader, entry);
+
+    free(live->shaders);
+    free(live);
+}
+
+static void glsl_program_cache_destroy(struct glsl_program_cache *cache)
+{
+    if (!cache)
+        return;
+    TRACE("Built %u of %u recorded programs.\n", cache->built, cache->known_count);
+    CloseHandle(cache->file);
+    wine_rb_destroy(&cache->known, glsl_program_cache_free_known, NULL);
+    wine_rb_destroy(&cache->live, glsl_program_cache_free_live, NULL);
+    free(cache->pending);
+    free(cache);
