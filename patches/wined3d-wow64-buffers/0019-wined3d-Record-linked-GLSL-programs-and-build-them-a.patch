+static int glsl_known_program_compare(const void *key, const struct wine_rb_entry *entry)
+{
+    return memcmp(key, &WINE_RB_ENTRY_VALUE(entry, const struct glsl_known_program, entry)->record,
+            sizeof(struct glsl_program_record));
+}
+
+static int glsl_live_shader_compare(const void *key, const struct wine_rb_entry *entry)
+{
+    uint64_t a = *(const uint64_t *)key, b = WINE_RB_ENTRY_VALUE(entry, const struct glsl_live_shader, entry)->hash;
+
+    return a < b ? -1 : a > b;
+}
+
+static void glsl_program_cache_header_init(struct glsl_program_cache_header *header)
+{
+    memset(header, 0, sizeof(*header));
+    memcpy(header->magic, "WD3DGLSL", sizeof(header->magic));
+    header->version = GLSL_PROGRAM_CACHE_VERSION;
+    header->sizes[0] = sizeof(struct glsl_program_record);
+    header->sizes[1] = sizeof(struct vs_compile_args);
+    header->sizes[2] = sizeof(struct wined3d_ffp_vs_settings);
+    header->sizes[3] = sizeof(struct ps_compile_args);
+    header->sizes[4] = sizeof(struct ffp_frag_settings);
+}
+
+/* A D3D shader's identity across runs: its type and byte code. */
+static uint64_t glsl_shader_get_hash(struct wined3d_shader *shader)
+{
+    struct glsl_shader_private *shader_data;
+    const unsigned char *code = shader->byte_code;
+    uint64_t hash = 0xcbf29ce484222325ull;
+    unsigned int i;
+
+    if (!shader->byte_code || shader->is_ffp_vs || shader->is_ffp_ps)
+        return 0;
+    if (!shader->backend_data && !(shader->backend_data = calloc(1, sizeof(*shader_data))))
+        return 0;
+    shader_data = shader->backend_data;
+    if (shader_data->hash)
+        return shader_data->hash;
+
+    hash = (hash ^ shader->reg_maps.shader_version.type) * 0x100000001b3ull;
+    hash = (hash ^ shader->source_type) * 0x100000001b3ull;
+    for (i = 0; i < shader->byte_code_size; ++i)
+        hash = (hash ^ code[i]) * 0x100000001b3ull;
+    hash ^= shader->byte_code_size;
+    return shader_data->hash = hash ? hash : 1;
+}
+
+static BOOL glsl_program_cache_enabled(void)
+{
+    static int enabled = -1;
+    char value[8];
+
+    if (enabled < 0)
+        enabled = !GetEnvironmentVariableA("WINED3D_PROGRAM_CACHE", value, sizeof(value)) || value[0] != '0';
+    return enabled;
+}
+
+static HANDLE glsl_program_cache_open_file(void)
+{
+    WCHAR path[MAX_PATH], exe[MAX_PATH];
+    const WCHAR *name;
+    DWORD length;
+
+    if (!(length = GetEnvironmentVariableW(L"LOCALAPPDATA", path, ARRAY_SIZE(path))) || length >= ARRAY_SIZE(path))
+        return INVALID_HANDLE_VALUE;
+    length = GetModuleFileNameW(NULL, exe, ARRAY_SIZE(exe));
+    if (!length || length >= ARRAY_SIZE(exe))
+        return INVALID_HANDLE_VALUE;
+    name = wcsrchr(exe, '\\') ? wcsrchr(exe, '\\') + 1 : exe;
+    if (wcslen(path) + wcslen(name) + 32 >= ARRAY_SIZE(path))
+        return INVALID_HANDLE_VALUE;
+    wcscat(path, L"\\wined3d");
+    CreateDirectoryW(path, NULL);
+    wcscat(path, L"\\");
+    wcscat(path, name);
+    wcscat(path, L".glslprograms");
+    TRACE("Program cache %s.\n", debugstr_w(path));
+    return CreateFileW(path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+            NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+}
+
+static struct glsl_known_program *glsl_program_cache_add(struct glsl_program_cache *cache,
+        const struct glsl_program_record *record)
+{
+    struct glsl_known_program *known;
+
+    if (cache->known_count >= GLSL_PROGRAM_CACHE_MAX_RECORDS || wine_rb_get(&cache->known, record))
+        return NULL;
+    if (!(known = malloc(sizeof(*known))))
+        return NULL;
+    known->record = *record;
+    wine_rb_put(&cache->known, &known->record, &known->entry);
+    ++cache->known_count;
+    return known;
+}
+
+static void glsl_program_cache_queue(struct glsl_program_cache *cache, struct glsl_known_program *known,
+        struct wined3d_shader *vshader, struct wined3d_shader *pshader)
+{
+    struct glsl_program_job *job;
+
+    if (!wined3d_array_reserve((void **)&cache->pending, &cache->pending_size,
+            cache->pending_count + 1, sizeof(*cache->pending)))
+        return;
+    job = &cache->pending[cache->pending_count++];
+    job->known = known;
+    job->vshader = vshader;
+    job->pshader = pshader;
+}
