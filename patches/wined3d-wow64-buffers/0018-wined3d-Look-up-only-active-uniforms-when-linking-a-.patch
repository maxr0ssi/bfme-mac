+/* A new program looks up the location of every uniform wined3d might declare, ~700 names for an
+ * SM1-3 vertex and pixel shader pair (every vs_c[i]/ps_c[i] up to the constant limit, the FFP
+ * state), almost all of them absent. Each lookup is a call into the driver, through the WoW64
+ * thunks for a 32-bit application. Listing the program's active uniforms first takes a few dozen
+ * calls, and only names in that list are looked up. The first programs are checked against the
+ * full lookup; a driver whose list misses a uniform that has a location disables the shortcut. */
+struct glsl_active_uniform
+{
+    const char *name;
+    GLint size;
+};
+
+struct glsl_active_uniforms
+{
+    struct glsl_active_uniform *uniforms;
+    unsigned int count;
+    char *names;
+};
+
+#define GLSL_ACTIVE_UNIFORMS_VERIFY_COUNT 16
+static LONG glsl_active_uniforms_verify = GLSL_ACTIVE_UNIFORMS_VERIFY_COUNT;
+static BOOL glsl_active_uniforms_broken;
+
+static int glsl_active_uniform_compare(const void *a, const void *b)
+{
+    return strcmp(((const struct glsl_active_uniform *)a)->name, ((const struct glsl_active_uniform *)b)->name);
+}
+
+static void shader_glsl_free_active_uniforms(struct glsl_active_uniforms *active)
+{
+    free(active->uniforms);
+    free(active->names);
+}
+
+static BOOL shader_glsl_get_active_uniforms(const struct wined3d_gl_info *gl_info, GLuint program_id,
+        struct glsl_active_uniforms *active)
+{
+    GLint count = 0, max_length = 0, size, length;
+    unsigned int i;
+    GLenum type;
+    char *name;
+
+    memset(active, 0, sizeof(*active));
+    if (glsl_active_uniforms_broken)
+        return FALSE;
+
+    GL_EXTCALL(glGetProgramiv(program_id, GL_ACTIVE_UNIFORMS, &count));
+    GL_EXTCALL(glGetProgramiv(program_id, GL_ACTIVE_UNIFORM_MAX_LENGTH, &max_length));
+    checkGLcall("query active uniforms");
+    if (count < 0 || (count && max_length <= 0))
+        return FALSE;
+    if (!count)
+        return TRUE;
+
+    active->uniforms = malloc(count * sizeof(*active->uniforms));
+    active->names = malloc((size_t)count * (max_length + 1));
+    if (!active->uniforms || !active->names)
+    {
+        shader_glsl_free_active_uniforms(active);
+        return FALSE;
+    }
+
+    for (i = 0, name = active->names; i < count; ++i, name += max_length + 1)
+    {
+        length = size = 0;
+        name[0] = 0;
+        GL_EXTCALL(glGetActiveUniform(program_id, i, max_length + 1, &length, &size, &type, name));
+        if (length < 0 || length > max_length)
+            length = strlen(name);
+        name[length] = 0;
+        /* Arrays are listed by their first element. */
+        if (length > 3 && !strcmp(name + length - 3, "[0]"))
+            name[length - 3] = 0;
+        active->uniforms[i].name = name;
+        active->uniforms[i].size = size;
+    }
+    checkGLcall("glGetActiveUniform");
+    active->count = count;
+    qsort(active->uniforms, active->count, sizeof(*active->uniforms), glsl_active_uniform_compare);
+    return TRUE;
+}
+
+static BOOL shader_glsl_uniform_is_active(const struct glsl_active_uniforms *active, const char *name)
+{
+    const struct glsl_active_uniform *uniform;
+    struct glsl_active_uniform key;
+    const char *bracket;
+    char base[64];
+    size_t length;
+
+    key.name = name;
+    if (bsearch(&key, active->uniforms, active->count, sizeof(key), glsl_active_uniform_compare))
+        return TRUE;
+
+    /* "vs_c[5]" is an element of the array "vs_c" of the listed size. */
+    length = strlen(name);
+    if (!length || name[length - 1] != ']' || !(bracket = strrchr(name, '['))
+            || strchr(bracket, '.') || bracket - name >= sizeof(base))
+        return FALSE;
+    memcpy(base, name, bracket - name);
+    base[bracket - name] = 0;
+    key.name = base;
+    if (!(uniform = bsearch(&key, active->uniforms, active->count, sizeof(key), glsl_active_uniform_compare)))
+        return FALSE;
+    return strtoul(bracket + 1, NULL, 10) < uniform->size;
+}
+
+static GLint shader_glsl_uniform_location(const struct wined3d_gl_info *gl_info, GLuint program_id,
+        const struct glsl_active_uniforms *active, const char *name)
+{
+    GLint location;
+
+    if (!active)
+        return GL_EXTCALL(glGetUniformLocation(program_id, name));
+
+    if (glsl_active_uniforms_verify > 0)
+    {
+        location = GL_EXTCALL(glGetUniformLocation(program_id, name));
+        if (location != -1 && !shader_glsl_uniform_is_active(active, name))
+        {
+            ERR("Uniform %s of program %u has location %d but is not listed as active; "
+                    "looking up every uniform from now on.\n", debugstr_a(name), program_id, location);
+            glsl_active_uniforms_broken = TRUE;
+        }
+        return location;
+    }
+
+    if (!shader_glsl_uniform_is_active(active, name))
+        return -1;
+    return GL_EXTCALL(glGetUniformLocation(program_id, name));
+}
