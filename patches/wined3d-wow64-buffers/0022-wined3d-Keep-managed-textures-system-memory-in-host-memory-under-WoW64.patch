diff --git a/dlls/wined3d/cs.c b/dlls/wined3d/cs.c
index 6babce6e395..a20d9b0c393 100644
--- a/dlls/wined3d/cs.c
+++ b/dlls/wined3d/cs.c
@@ -2917,6 +2917,11 @@ static void wined3d_cs_exec_add_dirty_texture_region(struct wined3d_cs *cs, cons
     unsigned int sub_resource_idx, i;
     struct wined3d_context *context;
 
+    /* A stashed managed texture has no location but its host copy; the next upload restores it.
+     * Restoring it here would bring every texture back at once on EvictManagedResources(). */
+    if (texture->sysmem_stash)
+        return;
+
     context = context_acquire(cs->c.device, NULL, 0);
     sub_resource_idx = op->layer * texture->level_count;
     for (i = 0; i < texture->level_count; ++i, ++sub_resource_idx)
