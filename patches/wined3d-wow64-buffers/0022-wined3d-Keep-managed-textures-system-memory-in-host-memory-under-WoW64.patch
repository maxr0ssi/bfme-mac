@@ -1525,6 +1537,20 @@ ULONG CDECL wined3d_texture_incref(struct wined3d_texture *texture)
     return refcount;
 }
 
+/* The host copy of a stashed managed texture (see wined3d_texture_stash_enabled()). */
+static void wined3d_texture_free_stash(struct wined3d_texture *texture)
+{
+    struct wined3d_unix_stash_params params;
+
+    if (!texture->sysmem_stash)
+        return;
+    params.data = 0;
+    params.stash = texture->sysmem_stash;
+    params.size = texture->resource.size;
+    WINE_UNIX_CALL(unix_stash_free, &params);
+    texture->sysmem_stash = 0;
+}
+
 static void wined3d_texture_destroy_object(void *object)
 {
     struct wined3d_texture *texture = object;
@@ -1538,6 +1564,8 @@ static void wined3d_texture_destroy_object(void *object)
     resource = &texture->resource;
     sub_count = texture->level_count * texture->layer_count;
 
+    wined3d_texture_free_stash(texture);
+
     if ((dc_info = texture->dc_info))
     {
         for (i = 0; i < sub_count; ++i)
@@ -2113,9 +2141,119 @@ static void wined3d_texture_gl_prepare_rb(struct wined3d_texture_gl *texture_gl,
     }
 }
 
+/* A d3d8/9 managed texture is a pair: a CPU-only texture that the application maps, and a GPU-only
+ * copy that draws use (d3d9_texture_init()). The CPU-only texture keeps its system memory for the
+ * texture's whole life, so under WoW64 every byte of managed texture costs a byte of the process's
+ * 2 GiB (3 GiB large-address-aware) address space, while the GPU copy lives in the host driver.
+ * Once the application has filled the texture (the unmap of its last sub-resource), and again
+ * after each upload, move the system memory to the host address space through wined3d.so and mark
+ * the sub-resources discarded; whatever needs WINED3D_LOCATION_SYSMEM again (the upload at the
+ * first draw, an upload after EvictManagedResources(), an application map, GetDC()) goes through
+ * wined3d_texture_prepare_location(), which copies it back first. A texture that the application
+ * maps again after a stash stays in system memory from then on. WINED3D_STASH_MANAGED=0 disables. */
+BOOL wined3d_texture_stash_enabled(void)
+{
+    static int enabled = -1;
+    char value[8];
+    BOOL wow64;
+
+    if (enabled < 0)
+    {
+        enabled = sizeof(void *) == 4 && wined3d_unixlib_loaded
+                && IsWow64Process(GetCurrentProcess(), &wow64) && wow64;
+        if (GetEnvironmentVariableA("WINED3D_STASH_MANAGED", value, sizeof(value)) && value[0] == '0')
+            enabled = 0;
+        TRACE("Stashing uploaded managed textures in host memory: %s.\n", enabled ? "yes" : "no");
+    }
+    return enabled;
+}
+
+/* Called on the CS thread, after the uploads queued before it. */
+static void wined3d_texture_stash_sysmem(void *object)
+{
+    struct wined3d_texture *texture = object;
+    unsigned int i, sub_count = texture->level_count * texture->layer_count;
+    struct wined3d_unix_stash_params params;
+
+    if (texture->sysmem_stash || texture->stash_pinned || !texture->resource.heap_memory
+            || texture->resource.map_count || texture->resource.pin_sysmem || texture->dc_info
+            || (texture->resource.access & WINED3D_RESOURCE_ACCESS_GPU))
+        return;
+    for (i = 0; i < sub_count; ++i)
+    {
+        const struct wined3d_texture_sub_resource *sub_resource = &texture->sub_resources[i];
+
+        /* Only a clean texture whose every sub-resource lives in our heap memory alone. */
+        if (sub_resource->locations != WINED3D_LOCATION_SYSMEM || sub_resource->user_memory
+                || sub_resource->map_count)
+            return;
+    }
+
+    params.data = (ULONG_PTR)texture->resource.heap_memory;
+    params.size = texture->resource.size;
+    params.stash = 0;
+    if (WINE_UNIX_CALL(unix_stash_put, &params))
+    {
+        WARN("Failed to stash %u bytes of texture %p.\n", texture->resource.size, texture);
+        return;
+    }
+
+    TRACE("Stashed %u bytes of texture %p.\n", texture->resource.size, texture);
+    texture->sysmem_stash = params.stash;
+    ++texture->stash_count;
+    for (i = 0; i < sub_count; ++i)
+    {
+        texture->sub_resources[i].locations = WINED3D_LOCATION_DISCARDED;
+        if (texture->sysmem_count)
+            --texture->sysmem_count;
+    }
+    wined3d_resource_free_sysmem(&texture->resource);
+}
+
+void wined3d_texture_stash_sysmem_async(struct wined3d_texture *texture)
+{
+    /* sysmem_stash belongs to the CS thread; after an eviction the upload queued just before this
+     * restores it, and the stash below runs after that upload. */
+    if (texture->stash_pinned)
+        return;
+    /* The stash frees the memory: application-thread maps (wined3d_texture_map_client()) and
+     * uploads (wined3d_device_context_upload_sysmem_region()) must wait for it. */
+    wined3d_resource_reference(&texture->resource);
+    wined3d_cs_init_object(texture->resource.device->cs, wined3d_texture_stash_sysmem, texture);
+}
+
+static BOOL wined3d_texture_unstash_sysmem(struct wined3d_texture *texture)
+{
+    unsigned int i, sub_count = texture->level_count * texture->layer_count;
+    struct wined3d_unix_stash_params params;
+
+    if (!wined3d_resource_prepare_sysmem(&texture->resource))
+        return FALSE;
+    params.data = (ULONG_PTR)texture->resource.heap_memory;
+    params.stash = texture->sysmem_stash;
+    params.size = texture->resource.size;
+    WINE_UNIX_CALL(unix_stash_get, &params);
+    WINE_UNIX_CALL(unix_stash_free, &params);
+    texture->sysmem_stash = 0;
+
+    TRACE("Restored %u bytes of texture %p.\n", texture->resource.size, texture);
+    for (i = 0; i < sub_count; ++i)
+    {
+        if (texture->sub_resources[i].locations == WINED3D_LOCATION_DISCARDED)
+        {
+            texture->sub_resources[i].locations = WINED3D_LOCATION_SYSMEM;
+            ++texture->sysmem_count;
+        }
+    }
+    return TRUE;
+}
+
 BOOL wined3d_texture_prepare_location(struct wined3d_texture *texture,
         unsigned int sub_resource_idx, struct wined3d_context *context, unsigned int location)
 {
+    if ((location & wined3d_texture_sysmem_locations) && texture->sysmem_stash
+            && !wined3d_texture_unstash_sysmem(texture))
+        return FALSE;
     return texture->texture_ops->texture_prepare_location(texture, sub_resource_idx, context, location);
 }
 
@@ -3467,6 +3605,10 @@ static HRESULT texture_resource_sub_resource_map(struct wined3d_resource *resour
 
     texture_level = sub_resource_idx % texture->level_count;
 
+    /* Mapped again after its upload: this texture changes, keep it in system memory. */
+    if (texture->stash_count)
+        texture->stash_pinned = TRUE;
+
     if (texture->flags & WINED3D_TEXTURE_DC_IN_USE)
     {
         WARN("DC is in use.\n");
@@ -3632,6 +3774,8 @@ bool wined3d_texture_map_client(struct wined3d_texture *texture, unsigned int su
         return false;
     if (!(sub_resource = wined3d_texture_get_sub_resource(texture, sub_resource_idx)) || sub_resource->map_count)
         return false;
+    if (texture->stash_count)
+        texture->stash_pinned = TRUE;
     if (wined3d_resource_is_busy(resource))
         return false;
 
diff --git a/dlls/wined3d/unix_gl.c b/dlls/wined3d/unix_gl.c
index 3312cecccc8..0b70681157f 100644
--- a/dlls/wined3d/unix_gl.c
+++ b/dlls/wined3d/unix_gl.c
@@ -23,6 +23,7 @@
 #include "config.h"
 
 #include <dlfcn.h>
+#include <stdlib.h>
 #include <string.h>
 
 #include "ntstatus.h"
@@ -78,9 +79,48 @@ static NTSTATUS buffer_write(void *args)
     return STATUS_SUCCESS;
 }
 
+/* Managed textures (texture.c, wined3d_texture_stash_sysmem()): the system memory copy of an
+ * uploaded texture moves out of the process's 2 GiB into host memory, and back when it is needed. */
+static NTSTATUS stash_put(void *args)
+{
+    struct wined3d_unix_stash_params *params = args;
+    void *stash;
+
+    if (!(stash = malloc(params->size)))
+        return STATUS_NO_MEMORY;
+    /* The point is to free the 32-bit address space; a host allocation inside it gains nothing. */
+    if ((ULONG_PTR)stash >> 32 == 0)
+    {
+        free(stash);
+        return STATUS_CONFLICTING_ADDRESSES;
+    }
+    memcpy(stash, (const void *)(ULONG_PTR)params->data, params->size);
+    params->stash = (ULONG_PTR)stash;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS stash_get(void *args)
+{
+    const struct wined3d_unix_stash_params *params = args;
+
+    memcpy((void *)(ULONG_PTR)params->data, (const void *)(ULONG_PTR)params->stash, params->size);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS stash_free(void *args)
+{
+    const struct wined3d_unix_stash_params *params = args;
+
+    free((void *)(ULONG_PTR)params->stash);
+    return STATUS_SUCCESS;
+}
+
 const unixlib_entry_t __wine_unix_call_funcs[] =
 {
     buffer_write,
+    stash_put,
+    stash_get,
+    stash_free,
 };
 
 C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count);
@@ -91,6 +131,9 @@ C_ASSERT(ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count);
 const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
 {
     buffer_write,
+    stash_put,
+    stash_get,
+    stash_free,
 };
 
 C_ASSERT(ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count);
diff --git a/dlls/wined3d/unixlib.h b/dlls/wined3d/unixlib.h
index 93b1b376e8b..50a88b5a4bb 100644
--- a/dlls/wined3d/unixlib.h
+++ b/dlls/wined3d/unixlib.h
@@ -33,9 +33,20 @@ struct wined3d_unix_buffer_write_params
     UINT32 pad;
 };
 
+/* A copy of a texture's system memory kept in the host (64-bit) address space. */
+struct wined3d_unix_stash_params
+{
+    UINT64 data;        /* the texture's system memory in the caller's address space */
+    UINT64 stash;       /* the host copy: returned by unix_stash_put, read by get and free */
+    UINT64 size;
+};
+
 enum wined3d_unix_funcs
 {
     unix_buffer_write,
+    unix_stash_put,
+    unix_stash_get,
+    unix_stash_free,
     unix_funcs_count,
 };
 
