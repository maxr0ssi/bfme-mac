@@ -3970,6 +3970,7 @@ HRESULT CDECL wined3d_device_update_texture(struct wined3d_device *device,
             wined3d_texture_get_level_box(dst_texture, i, &box);
             for (j = 0; j < layer_count; ++j)
             {
+                uploaded = TRUE;
                 wined3d_device_context_update_texture_region(&device->cs->c,
                         dst_texture, j * dst_level_count + i, &box,
                         src_texture, j * src_level_count + i + src_skip_levels, &box);
@@ -4015,6 +4016,7 @@ HRESULT CDECL wined3d_device_update_texture(struct wined3d_device *device,
                                 wined3d_texture_get_level_depth(src_texture, src_level));
                     }
 
+                    uploaded = TRUE;
                     wined3d_device_context_update_texture_region(&device->cs->c,
                             dst_texture, i * dst_level_count + j, &box,
                             src_texture, i * src_level_count + src_level, &box);
@@ -4025,6 +4027,10 @@ HRESULT CDECL wined3d_device_update_texture(struct wined3d_device *device,
 
     wined3d_texture_clear_dirty_regions(src_texture);
 
+    /* The CPU-only half of a d3d8/9 managed texture; see wined3d_texture_stash_enabled(). */
+    if (uploaded && (src_texture->resource.usage & WINED3DUSAGE_MANAGED) && wined3d_texture_stash_enabled())
+        wined3d_texture_stash_sysmem_async(src_texture);
+
     return WINED3D_OK;
 }
 
@@ -4703,6 +4709,18 @@ HRESULT CDECL wined3d_device_context_unmap(struct wined3d_device_context *contex
 
     wined3d_device_context_lock(context);
     hr = wined3d_device_context_emit_unmap(context, resource, sub_resource_idx);
+    /* A managed texture is filled level by level, the smallest last: stash it right away, so a
+     * level's worth of textures loaded before their first draw does not hold the address space
+     * either (see wined3d_texture_stash_enabled()). */
+    if (SUCCEEDED(hr) && resource->type != WINED3D_RTYPE_BUFFER && context == &context->device->cs->c
+            && (resource->usage & WINED3DUSAGE_MANAGED) && !(resource->access & WINED3D_RESOURCE_ACCESS_GPU)
+            && !resource->map_count && wined3d_texture_stash_enabled())
+    {
+        struct wined3d_texture *texture = texture_from_resource(resource);
+
+        if (sub_resource_idx == texture->level_count * texture->layer_count - 1)
+            wined3d_texture_stash_sysmem_async(texture);
+    }
     wined3d_device_context_unlock(context);
     return hr;
 }
