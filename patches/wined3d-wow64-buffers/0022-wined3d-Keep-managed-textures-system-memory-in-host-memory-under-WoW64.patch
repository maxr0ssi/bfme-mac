index 4ad1e65fafb..2df0e50e290 100644
--- a/dlls/wined3d/surface.c
+++ b/dlls/wined3d/surface.c
@@ -1336,6 +1336,10 @@ static bool sub_resource_is_on_cpu(const struct wined3d_texture *texture, unsign
     if (!(texture->resource.access & WINED3D_RESOURCE_ACCESS_GPU) && (locations & WINED3D_LOCATION_CLEARED))
         return true;
 
